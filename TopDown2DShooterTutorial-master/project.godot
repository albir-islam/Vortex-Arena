; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Top Down 2d Shooter Tutorial"
run/main_scene="res://Scenes/Login.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

APIService="*res://Scripts/APIService.gd"
GameState="*res://Scripts/GameState.gd"
Network="*res://Scripts/Network.gd"
GameManager="*res://Scripts/game_manager.gd"
SettingsManager="*res://Scripts/Settings.gd"
MusicManager="*res://Scenes/MusicManager.tscn"
MultiplayerNetwork="*res://Scripts/MultiplayerNetwork.gd"

[vortex_arena]

server_host="10.15.62.114"
server_port=7320

[display]

window/size/viewport_height=720
window/size/window_height_override=982
#Internalresolutionforscaling.window/size/viewport_width=1280
#Windowdefaults(willbeoverriddenatruntimetomatchthescreenusablesize).window/size/window_width_override=1512
#BetteronRetinadisplays.window/dpi/allow_hidpi=true
#Scalegametothewindowsize.window/stretch/mode="canvas_items"

[gui]

theme/default_theme_scale=1.15


[sub_resource type="Shader" id="Shader_lobby_bg_blur"]
code = "shader_type canvas_item;\n\nuniform float strength : hint_range(0.0, 1.0) = 0.15;\nuniform float radius_px : hint_range(0.0, 12.0) = 4.0;\n\nvoid fragment() {\n\tvec4 original = texture(TEXTURE, UV);\t\n\tvec2 px = 1.0 / vec2(textureSize(TEXTURE, 0));\tvec2 o = px * radius_px;\n\t\n\tvec4 sum = original;\tsum += texture(TEXTURE, UV + vec2(o.x, 0.0));\tsum += texture(TEXTURE, UV - vec2(o.x, 0.0));\tsum += texture(TEXTURE, UV + vec2(0.0, o.y));\tsum += texture(TEXTURE, UV - vec2(0.0, o.y));\tsum += texture(TEXTURE, UV + o);\tsum += texture(TEXTURE, UV - o);\tsum += texture(TEXTURE, UV + vec2(o.x, -o.y));\tsum += texture(TEXTURE, UV + vec2(-o.x, o.y));\t\n\tvec4 blurred = sum / 9.0;\t\n\tCOLOR = mix(original, blurred, strength);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_lobby_bg_blur"]
shader = SubResource("Shader_lobby_bg_blur")
shader_parameter/strength = 0.5
shader_parameter/radius_px = 4.0

[sub_resource type="Shader" id="Shader_nameplate_blur"]
code = "shader_type canvas_item;\n\nuniform sampler2D screen_texture : hint_screen_texture, filter_linear_mipmap;\nuniform float radius_px : hint_range(0.0, 18.0) = 10.0;\nuniform vec4 tint : source_color = vec4(0.10, 0.10, 0.15, 0.35);\n\nvoid fragment() {\n\tvec2 px = 1.0 / vec2(textureSize(screen_texture, 0));\tvec2 o = px * radius_px;\n\tvec4 sum = texture(screen_texture, SCREEN_UV);\tsum += texture(screen_texture, SCREEN_UV + vec2(o.x, 0.0));\tsum += texture(screen_texture, SCREEN_UV - vec2(o.x, 0.0));\tsum += texture(screen_texture, SCREEN_UV + vec2(0.0, o.y));\tsum += texture(screen_texture, SCREEN_UV - vec2(0.0, o.y));\tsum += texture(screen_texture, SCREEN_UV + o);\tsum += texture(screen_texture, SCREEN_UV - o);\tsum += texture(screen_texture, SCREEN_UV + vec2(o.x, -o.y));\tsum += texture(screen_texture, SCREEN_UV + vec2(-o.x, o.y));\t\n\tvec4 blurred = sum / 9.0;\t\n\tCOLOR = blurred * (1.0 - tint.a) + tint;\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_nameplate_blur"]
shader = SubResource("Shader_nameplate_blur")
shader_parameter/radius_px = 10.0
shader_parameter/tint = Color(0.1, 0.1, 0.15, 0.35)

